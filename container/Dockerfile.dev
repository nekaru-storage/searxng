# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Development image: only the Python dependencies are baked into the image,
# the source tree is bind-mounted by ``docker-compose.dev.yml`` so that code
# changes are picked up without rebuilding.
FROM docker.io/library/python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    SEARXNG_SETTINGS_PATH=/etc/searxng/settings.yml

WORKDIR /app

# ``git`` is needed by ``searx.version`` to derive the version string from the
# bind-mounted repository.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY ./requirements.txt ./requirements-server.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-server.txt

# The test/lint tooling is optional: it is only needed when the unit tests are
# run *inside* the container.  Build with ``--build-arg INSTALL_DEV_DEPS=1``
# (or ``SEARXNG_DEV_DEPS=1`` for the compose file) to get nose2, black, pylint
# and basedpyright; the default image stays small.
ARG INSTALL_DEV_DEPS=0
COPY ./requirements-dev.txt ./
RUN if [ "$INSTALL_DEV_DEPS" = "1" ]; then \
    pip install --no-cache-dir -r requirements-dev.txt; \
    fi

EXPOSE 8080

CMD ["granian", "--interface", "wsgi", "--host", "0.0.0.0", "--port", "8080", "searx.webapp:app"]
